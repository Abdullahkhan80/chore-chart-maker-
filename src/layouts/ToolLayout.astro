---
import MainLayout from './MainLayout.astro';
import Byline from '../components/Byline.astro';
import Faq from '../components/Faq.astro';
import ChoreChartMaker from '../components/ChoreChartMaker.astro';
import type { PageMeta } from '../lib/pages.ts';
import { PAGE_PRESETS } from '../lib/presets.ts';
import { buildFaqPage, buildWebApplication, type FaqItem } from '../lib/seo.ts';

interface Props {
  page: PageMeta;
  /** Editor preset; defaults to the page's entry in PAGE_PRESETS. */
  preset?: string;
  /** Rendered as the visible FAQ and as FAQPage JSON-LD from the same text. */
  faq?: FaqItem[];
}

const { page, preset = PAGE_PRESETS[page.path] ?? 'weekly', faq = [] } = Astro.props;
const jsonLd = [buildWebApplication({ name: page.label, path: page.path, description: page.description })];
if (faq.length > 0) jsonLd.push(buildFaqPage(faq));
---

<MainLayout page={page} breadcrumbs={[{ name: page.label, path: page.path }]} jsonLd={jsonLd}>
  <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">{page.h1}</h1>
  <p class="mt-2 max-w-prose text-muted"><slot name="intro" /></p>
  <div class="mt-4">
    <ChoreChartMaker preset={preset} />
  </div>
  <div class="prose-content mt-12 max-w-prose">
    <Byline lastmod={page.lastmod} />
    <slot />
    <Faq items={faq} />
  </div>
</MainLayout>
