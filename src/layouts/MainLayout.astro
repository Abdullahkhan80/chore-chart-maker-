---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pageOgImagePath, type PageMeta } from '../lib/pages.ts';
import { SITE_CONFIG, buildBreadcrumbList, type BreadcrumbItem, type JsonLd } from '../lib/seo.ts';

interface Props {
  page: PageMeta;
  /** Trail after "Home"; renders visible breadcrumbs plus BreadcrumbList JSON-LD. */
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: JsonLd[];
  ogType?: 'website' | 'article';
  /** Full-width <main> for pages that lay out their own sections (the homepage). */
  wide?: boolean;
}

const { page, breadcrumbs, jsonLd = [], ogType, wide = false } = Astro.props;
const trail = breadcrumbs ? [{ name: 'Home', path: '/' }, ...breadcrumbs] : undefined;
const structuredData = trail ? [...jsonLd, buildBreadcrumbList(trail)] : jsonLd;
const ogImagePath = pageOgImagePath(page);
const ogImage = ogImagePath ? { ...SITE_CONFIG.ogImage, path: ogImagePath, alt: `${page.h1}: ${SITE_CONFIG.name}` } : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MNZ7RR8HG8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MNZ7RR8HG8');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/nunito-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <SEO
      title={page.title}
      description={page.description}
      path={page.path}
      noindex={page.noindex}
      ogType={ogType}
      ogImage={ogImage}
      article={ogType === 'article' ? { published: page.published, modified: page.lastmod } : undefined}
      jsonLd={structuredData}
    />
    <meta name="theme-color" content={SITE_CONFIG.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SITE_CONFIG.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-sans text-fg antialiased">
    <a
      href="#main"
      class="sr-only rounded bg-brand px-4 py-2 font-semibold text-brand-fg focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      Skip to main content
    </a>
    <Header currentPath={page.path} />
    <main
      id="main"
      tabindex="-1"
      class:list={['w-full flex-1 focus:outline-none', !wide && 'mx-auto max-w-5xl px-4 py-8']}
    >
      {trail && <Breadcrumbs items={trail} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
