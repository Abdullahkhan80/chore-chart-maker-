---
import MainLayout from './MainLayout.astro';
import ChoreChartMaker from '../components/ChoreChartMaker.astro';
import { pageOgImagePath, type PageMeta } from '../lib/pages.ts';
import { buildArticle, type BreadcrumbItem } from '../lib/seo.ts';

interface Props {
  page: PageMeta;
  /** Breadcrumb trail after "Home"; defaults to just this page. */
  breadcrumbs?: BreadcrumbItem[];
  /** When set, the chart editor is shown under the headline with this preset. */
  preset?: string;
}

const { page, breadcrumbs = [{ name: page.label, path: page.path }], preset } = Astro.props;
const article = buildArticle({
  headline: page.h1,
  description: page.description,
  path: page.path,
  datePublished: page.published,
  dateModified: page.lastmod,
  imagePath: pageOgImagePath(page),
});
---

<MainLayout page={page} breadcrumbs={breadcrumbs} jsonLd={[article]} ogType="article">
  <article class="max-w-prose">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{page.h1}</h1>
    <p class="mt-2 text-sm text-muted">Updated <time datetime={page.lastmod}>{page.lastmod}</time></p>
  </article>
  {preset && <div class="mt-6"><ChoreChartMaker preset={preset} /></div>}
  <div class="mt-8 max-w-prose space-y-4 text-lg"><slot /></div>
</MainLayout>
