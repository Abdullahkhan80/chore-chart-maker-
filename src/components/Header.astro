---
import { PAGES } from '../lib/pages.ts';
import { SITE_CONFIG } from '../lib/seo.ts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  { href: PAGES.choreChartMaker.path, label: 'Chore Chart Maker' },
  { href: PAGES.rewardChartMaker.path, label: 'Reward Chart' },
  { href: PAGES.choresByAge.path, label: 'Chores by Age' },
  { href: PAGES.freeChoreChartTemplate.path, label: 'Templates' },
  { href: PAGES.about.path, label: 'About' },
];
const cta = { href: PAGES.choreChartMaker.path, label: 'Create a Chart' };
const current = (href: string) => (currentPath === href ? 'page' : undefined);
---

<header class="site-header print:hidden">
  <div class="container-page site-header-bar">
    <a href="/" class="site-logo">
      <img src="/ui/logo.svg" alt="" width="32" height="32" />
      <span>{SITE_CONFIG.name}</span>
    </a>
    <nav aria-label="Main" class="site-nav">
      <ul class="site-nav-list">
        {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      </ul>
      <a href={cta.href} class="btn btn-primary site-header-cta">{cta.label}</a>
      <details class="site-menu">
        <summary><span class="site-menu-icon" aria-hidden="true"></span>Menu</summary>
        <div class="site-menu-panel">
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
          <a href={cta.href} class="btn btn-primary">{cta.label}</a>
        </div>
      </details>
    </nav>
  </div>
</header>
