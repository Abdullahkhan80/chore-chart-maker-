---
import { PAGES } from '../lib/pages.ts';
import { SITE_CONFIG } from '../lib/seo.ts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isPt = currentPath === PAGES.ptChoreChartMaker.path;
const isFr = currentPath === PAGES.frChoreChartMaker.path;

const nav = isPt
  ? [
      { href: PAGES.ptChoreChartMaker.path, label: 'Criador de Quadro' },
      { href: PAGES.rewardChartMaker.path, label: 'Quadro de Recompensas' },
      { href: PAGES.choresByAge.path, label: 'Tarefas por Idade' },
      { href: PAGES.freeChoreChartTemplate.path, label: 'Modelos' },
      { href: PAGES.about.path, label: 'Sobre' },
    ]
  : isFr
    ? [
        { href: PAGES.frChoreChartMaker.path, label: 'Tableau de Tâches' },
        { href: PAGES.rewardChartMaker.path, label: 'Tableau de Récompenses' },
        { href: PAGES.choresByAge.path, label: 'Tâches par Âge' },
        { href: PAGES.freeChoreChartTemplate.path, label: 'Modèles' },
        { href: PAGES.about.path, label: 'À propos' },
      ]
    : [
        { href: PAGES.choreChartMaker.path, label: 'Chore Chart Maker' },
        { href: PAGES.rewardChartMaker.path, label: 'Reward Chart' },
        { href: PAGES.choresByAge.path, label: 'Chores by Age' },
        { href: PAGES.freeChoreChartTemplate.path, label: 'Templates' },
        { href: PAGES.about.path, label: 'About' },
      ];
const cta = isPt
  ? { href: PAGES.ptChoreChartMaker.path, label: 'Criar Quadro' }
  : isFr
    ? { href: PAGES.frChoreChartMaker.path, label: 'Créer un Tableau' }
    : { href: PAGES.choreChartMaker.path, label: 'Create a Chart' };
const current = (href: string) => (currentPath === href ? 'page' : undefined);

const currentLang = isPt
  ? { code: 'PT', label: 'Português' }
  : isFr
    ? { code: 'FR', label: 'Français' }
    : { code: 'EN', label: 'English' };

const languages = [
  { code: 'EN', hreflang: 'en', label: 'English', href: PAGES.choreChartMaker.path },
  { code: 'PT', hreflang: 'pt-BR', label: 'Português', href: PAGES.ptChoreChartMaker.path },
  { code: 'FR', hreflang: 'fr', label: 'Français', href: PAGES.frChoreChartMaker.path },
];
---

<header class="site-header print:hidden">
  <div class="container-page site-header-bar">
    <a href="/" class="site-logo">
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span>{SITE_CONFIG.name}</span>
    </a>
    <nav aria-label="Main" class="site-nav">
      <ul class="site-nav-list">
        {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      </ul>
      <details class="site-lang-dropdown">
        <summary aria-label="Select language">
          <span class="site-lang-globe" aria-hidden="true">🌐</span>
          <span>{currentLang.code}</span>
          <span class="site-lang-arrow" aria-hidden="true">▾</span>
        </summary>
        <div class="site-lang-menu">
          {languages.map((l) => (
            <a href={l.href} class={`site-lang-item${currentPath === l.href ? ' is-active' : ''}`} hreflang={l.hreflang}>
              <strong>{l.code}</strong> {l.label}
            </a>
          ))}
        </div>
      </details>
      <a href={cta.href} class="btn btn-primary site-header-cta">{cta.label}</a>
      <details class="site-menu">
        <summary><span class="site-menu-icon" aria-hidden="true"></span>Menu</summary>
        <div class="site-menu-panel">
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
          <a href={cta.href} class="btn btn-primary">{cta.label}</a>
        </div>
      </details>
    </nav>
  </div>
</header>
