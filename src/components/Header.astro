---
import { PAGES } from '../lib/pages.ts';
import { SITE_CONFIG } from '../lib/seo.ts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  { href: PAGES.choreChartMaker.path, label: 'Chore Chart Maker' },
  { href: PAGES.rewardChartMaker.path, label: 'Reward Chart' },
  { href: PAGES.choresByAge.path, label: 'Chores by Age' },
  { href: PAGES.about.path, label: 'About' },
];
---

<header class="border-b border-line print:hidden">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-semibold text-fg no-underline">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>{SITE_CONFIG.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class="text-muted hover:text-brand aria-[current=page]:font-semibold aria-[current=page]:text-brand"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
