---
import { PAGES, AGE_PAGE_AGES, agePagePath } from '../lib/pages.ts';
import { SITE_CONFIG } from '../lib/seo.ts';

interface Props {
  currentPath?: string;
  lang?: string;
}

const { currentPath, lang } = Astro.props;
const isPt = lang?.startsWith('pt') || currentPath === PAGES.ptChoreChartMaker.path;
const isFr = lang?.startsWith('fr') || currentPath === PAGES.frChoreChartMaker.path;

const labels = isPt
  ? {
      tools: 'Ferramentas',
      guides: 'Guias',
      site: 'Site e Idiomas',
      tagline: 'Tabelas de tarefas e rotinas gratuitas para imprimir para famílias e repúblicas. Feitas no seu navegador: sem cadastro, zero uploads.',
      copyright: `© ${new Date().getFullYear()} ${SITE_CONFIG.name}. Ferramentas gratuitas para imprimir para lares ocupados.`,
    }
  : isFr
    ? {
        tools: 'Outils',
        guides: 'Guides',
        site: 'Site et Langues',
        tagline: 'Tableaux de tâches et routines gratuits à imprimer pour la famille et la colocation. Dans votre navigateur : sans inscription ni transfert de données.',
        copyright: `© ${new Date().getFullYear()} ${SITE_CONFIG.name}. Outils imprimables gratuits pour les familles occupées.`,
      }
    : {
        tools: 'Tools',
        guides: 'Guides',
        site: 'Site & Languages',
        tagline: 'Free printable chore charts and routines for families and shared homes. Made in your browser: no accounts, zero uploads.',
        copyright: `© ${new Date().getFullYear()} ${SITE_CONFIG.name}. Free printable tools, made for busy homes.`,
      };

const columns = [
  {
    label: labels.tools,
    links: [
      isPt ? { path: PAGES.ptChoreChartMaker.path, label: 'Criador de Quadro' } : isFr ? { path: PAGES.frChoreChartMaker.path, label: 'Tableau de Tâches' } : PAGES.choreChartMaker,
      { ...PAGES.rewardChartMaker, label: isPt ? 'Quadro de Recompensas' : isFr ? 'Tableau de Récompenses' : 'Reward Chart Maker' },
      { ...PAGES.freeChoreChartTemplate, label: isPt ? 'Modelos de Tabela' : isFr ? 'Modèles Gratuits' : 'Templates' },
      { ...PAGES.familyChoreChart, label: isPt ? 'Tabela Familiar' : isFr ? 'Tableau Familial' : PAGES.familyChoreChart.label },
      { ...PAGES.roommateChoreChart, label: isPt ? 'Tabela para Repúblicas' : isFr ? 'Tableau de Colocation' : PAGES.roommateChoreChart.label },
      { ...PAGES.morningRoutineChart, label: isPt ? 'Rotina Matinal' : isFr ? 'Routine du Matin' : PAGES.morningRoutineChart.label },
      { ...PAGES.bedtimeRoutineChart, label: isPt ? 'Rotina Noturna' : isFr ? 'Routine du Soir' : PAGES.bedtimeRoutineChart.label },
      { ...PAGES.elegantChoreChart, label: isPt ? 'Tabela Minimalista' : isFr ? 'Tableau Minimaliste' : PAGES.elegantChoreChart.label },
    ],
  },
  {
    label: labels.guides,
    links: [
      { path: PAGES.choresByAge.path, label: isPt ? 'Tarefas por Idade' : isFr ? 'Tâches par Âge' : PAGES.choresByAge.label },
      ...AGE_PAGE_AGES.map((age) => ({ path: agePagePath(age), label: isPt ? `${age} Anos` : isFr ? `${age} Ans` : `Age ${age}` })),
    ],
  },
  {
    label: labels.site,
    links: [
      { path: PAGES.about.path, label: isPt ? 'Sobre' : isFr ? 'À propos' : PAGES.about.label },
      { path: PAGES.contact.path, label: isPt ? 'Contato' : isFr ? 'Contact' : PAGES.contact.label },
      { path: PAGES.privacyPolicy.path, label: isPt ? 'Privacidade' : isFr ? 'Confidentialité' : PAGES.privacyPolicy.label },
      { path: PAGES.terms.path, label: isPt ? 'Termos' : isFr ? 'Conditions' : PAGES.terms.label },
      { path: PAGES.choreChartMaker.path, label: 'English (US)' },
      { path: PAGES.ptChoreChartMaker.path, label: 'Português (Brasil)' },
      { path: PAGES.frChoreChartMaker.path, label: 'Français' },
    ],
  },
];
---

<footer class="site-footer print:hidden">
  <div class="container-page site-footer-grid">
    <div class="max-w-sm">
      <a href="/" class="site-logo !text-fg !no-underline">
        <img src="/favicon.svg" alt="" width="28" height="28" loading="lazy" />
        <span>{SITE_CONFIG.name}</span>
      </a>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
        {labels.tagline}
      </p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.label}>
          <p class="text-sm font-bold text-fg">{column.label}</p>
          <ul class="mt-3 space-y-1 text-[0.95rem]">
            {column.links.map((link) => (
              <li>
                <a href={link.path}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container-page border-t border-line py-6 text-sm text-muted">
    {labels.copyright}
  </div>
</footer>
