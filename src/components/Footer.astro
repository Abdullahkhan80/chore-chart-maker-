---
import { PAGES, AGE_PAGE_AGES, agePage } from '../lib/pages.ts';
import { SITE_CONFIG } from '../lib/seo.ts';

const columns = [
  {
    label: 'Tools',
    links: [
      PAGES.choreChartMaker,
      { ...PAGES.rewardChartMaker, label: 'Reward Chart Maker' },
      { ...PAGES.freeChoreChartTemplate, label: 'Templates' },
      PAGES.familyChoreChart,
      PAGES.roommateChoreChart,
      PAGES.morningRoutineChart,
      PAGES.elegantChoreChart,
    ],
  },
  {
    label: 'Guides',
    links: [PAGES.choresByAge, ...AGE_PAGE_AGES.filter((age) => age % 3 === 0).map(agePage)],
  },
  {
    label: 'Site',
    links: [PAGES.about, PAGES.contact, PAGES.privacyPolicy, PAGES.terms],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer print:hidden">
  <div class="container-page site-footer-grid">
    <div class="max-w-sm">
      <a href="/" class="site-logo !text-fg !no-underline">
        <img src="/ui/logo.svg" alt="" width="28" height="28" loading="lazy" />
        <span>{SITE_CONFIG.name}</span>
      </a>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
        Free printable chore charts, reward charts and routines for families, classrooms and shared homes. Charts are
        made in your browser: no accounts, and nothing you type is uploaded.
      </p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.label}>
          <p class="text-sm font-bold text-fg">{column.label}</p>
          <ul class="mt-3 space-y-1 text-[0.95rem]">
            {column.links.map((link) => (
              <li>
                <a href={link.path}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container-page border-t border-line py-6 text-sm text-muted">
    © {year} {SITE_CONFIG.name}. Free printable tools, made for busy homes.
  </div>
</footer>
