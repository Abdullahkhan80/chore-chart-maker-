---
import { SITE_CONFIG } from '../lib/seo.ts';

interface Props {
  /** ISO date (YYYY-MM-DD). */
  lastmod: string;
}

const { lastmod } = Astro.props;
// Parse as UTC so the printed day matches the ISO date in every build time zone.
const formatted = new Date(`${lastmod}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<p class="text-sm text-muted">
  By <a href={SITE_CONFIG.author.path} rel="author" class="text-brand underline">{SITE_CONFIG.author.name}</a> ·
  Last updated <time datetime={lastmod}>{formatted}</time>
</p>
