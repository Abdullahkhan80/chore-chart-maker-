---
import type { AlternateLink } from '../lib/pages.ts';
import {
  SITE_CONFIG,
  buildAssetUrl,
  buildCanonicalUrl,
  buildPageGraph,
  serializeJsonLd,
  type JsonLd,
} from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: { path: string; width: number; height: number; alt: string };
  locale?: string;
  alternates?: AlternateLink[];
  /** Article dates (ISO YYYY-MM-DD) for og:type "article". */
  article?: { published: string; modified: string };
  datePublished?: string;
  dateModified?: string;
  jsonLd?: JsonLd[];
}

const {
  title,
  description,
  path,
  noindex = false,
  ogType = 'website',
  ogImage = SITE_CONFIG.ogImage,
  locale = SITE_CONFIG.locale,
  alternates,
  article,
  datePublished,
  dateModified,
  jsonLd = [],
} = Astro.props;

const canonical = buildCanonicalUrl(path);
const imageUrl = buildAssetUrl(ogImage.path);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';

const graph = !noindex
  ? buildPageGraph({
      path,
      title,
      description,
      lang: locale === 'pt_BR' ? 'pt-BR' : locale === 'fr_FR' ? 'fr-FR' : 'en-US',
      datePublished: datePublished ?? article?.published,
      dateModified: dateModified ?? article?.modified,
      imagePath: ogImage.path,
      nodes: jsonLd,
    })
  : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonical} />}
{
  !noindex && alternates && alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.lang} href={buildCanonicalUrl(alt.path)} />
  ))
}
{!noindex && alternates && <link rel="alternate" hreflang="x-default" href={buildCanonicalUrl('/chore-chart-maker/')} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_CONFIG.name} />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />

{
  ogType === 'article' && article && (
    <>
      <meta property="article:published_time" content={article.published} />
      <meta property="article:modified_time" content={article.modified} />
      <meta property="article:author" content={buildCanonicalUrl(SITE_CONFIG.author.path)} />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={ogImage.alt} />

{graph && <script type="application/ld+json" is:inline set:html={serializeJsonLd(graph)} />}
