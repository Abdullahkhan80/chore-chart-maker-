---
import ToolLayout from '../layouts/ToolLayout.astro';
import { AGE_PAGE_AGES, PAGES, agePagePath } from '../lib/pages.ts';
import type { FaqItem } from '../lib/seo.ts';

const ageBands: { label: string; ages: number[]; chores: string }[] = [
  { label: '2–3', ages: [2, 3], chores: 'Put toys in a bin, clothes in the hamper, wipe up small spills, help feed a pet.' },
  { label: '4–5', ages: [4, 5], chores: 'Make the bed (roughly), set the table, match socks, water plants, tidy their room.' },
  { label: '6–7', ages: [6, 7], chores: 'Put away silverware, sweep, fold towels, feed pets, pack their backpack.' },
  { label: '8–9', ages: [8, 9], chores: 'Load the dishwasher, vacuum a room, take out trash, put away their own laundry.' },
  { label: '10–12', ages: [10, 11, 12], chores: 'Run a load of laundry, clean the bathroom, make a simple meal, rake or weed.' },
  { label: '13–14', ages: [13, 14], chores: 'Cook a family dinner, deep-clean the kitchen, mow the lawn, manage their own laundry.' },
];
const livePages = new Set<number>(AGE_PAGE_AGES);

const faq: FaqItem[] = [
  {
    question: 'What chores should a 5-year-old do?',
    answer:
      'Most 5-year-olds can make their bed, set the table, put clothes in the hamper, match socks, feed a pet, water plants and tidy their toys. Pick three to five, show them how first, and use picture icons so they follow the chart on their own.',
  },
  {
    question: 'How many chores should a child have?',
    answer:
      'Start with three to five daily chores for kids under 8 and five to seven for older kids, plus one or two weekly jobs. A short chart that gets done daily teaches more than a long one that gets ignored.',
  },
  {
    question: 'Should kids get paid for chores?',
    answer:
      'Many families split chores: everyday jobs (making bed, clearing plates) are unpaid family contributions, while extra jobs (washing cars) can earn money. This teaches responsibility without turning daily help into negotiations.',
  },
  {
    question: 'Can I edit the chart later?',
    answer:
      'Yes. Your chart saves in the browser on your device so you can return anytime. To edit on another device, use Copy share link and open that link there.',
  },
  {
    question: 'Is this chore chart maker really free?',
    answer:
      'Yes. Every chart type, theme and export format is free with no sign-up, trial or paywall. Print as many charts as you like.',
  },
  {
    question: 'What age should kids start doing chores?',
    answer:
      'Kids can start around age 2 with simple tasks like putting toys in bins or clothes in hampers. Doing small jobs together builds lasting habits.',
  },
  {
    question: 'Can I make one chore chart for several kids?',
    answer:
      'Yes. Add up to eight people in step 1 and choose Family chart. Put everyone on one color-coded chart or print one page per child.',
  },
  {
    question: 'How do I make a chore chart for a child who cannot read yet?',
    answer:
      'Every chore has a picture icon so pre-readers follow along by pictures alone. Turn on large text and review together daily.',
  },
];
---

<ToolLayout page={PAGES.choreChartMaker} faq={faq}>
  <div slot="intro">
    <div class="mb-3 text-xs text-muted">
      Language: <span class="font-bold text-fg">English</span> · <a href={PAGES.ptChoreChartMaker.path} class="underline">Português</a> · <a href={PAGES.frChoreChartMaker.path} class="underline">Français</a>
    </div>
    <p>
      Our free chore chart maker is a fast in-browser chore chart generator designed for busy families. Build a printable chore chart for your kids in minutes: choose age-appropriate picture chores, customize daily or weekly schedules, and print directly. No sign-up, no subscriptions, and nothing you type leaves your browser.
    </p>
  </div>

  <h2>How to make a chore chart in 4 steps</h2>
  <p>Follow four quick steps; the chart preview updates as you make changes.</p>
  <ol>
    <li>
      <strong>Who is it for?</strong> Title your chart and add up to eight children, with optional ages for tailored chore ideas.
    </li>
    <li>
      <strong>Chores.</strong> Choose suggested chores, browse the library or type custom tasks with pictures.
    </li>
    <li>
      <strong>Style.</strong> Select a weekly, routine or reward layout, theme, paper size, and optional stickers or allowance.
    </li>
    <li>
      <strong>Download.</strong> Print directly, save a PDF or PNG, or copy a private share link.
    </li>
  </ol>

  <h2>What makes this chore chart maker different</h2>
  <ul>
    <li>
      <strong>Zero accounts or subscriptions:</strong> Every chart layout, theme, and export format is 100% free with no watermarks or hidden paywalls.
    </li>
    <li>
      <strong>Total browser privacy:</strong> Your children's names, ages, and chores stay on your own device. Nothing you type is uploaded to remote servers.
    </li>
    <li>
      <strong>Picture icons for pre-readers:</strong> Over 120 illustrated chore icons allow toddlers and young children to follow their routines independently before they can read.
    </li>
    <li>
      <strong>Flexible print & digital formats:</strong> Export print-ready PDFs sized for Letter or A4, PNG images for phone and tablet screens, or copy a private share link.
    </li>
  </ul>

  <h2>Age-appropriate chores at a glance</h2>
  <p>
    Kids can usually do more than we expect, but the right chore depends on attention span and coordination as much
    as age. Use this table as a starting point, then see our full guide to
    <a href={PAGES.choresByAge.path}>chores for kids by age</a>. If you add your child's age in step 1, the chart maker
    suggests chores from the same range.
  </p>
  <div class="overflow-x-auto">
    <table>
      <thead>
        <tr><th scope="col">Age</th><th scope="col">Chores they can usually handle</th><th scope="col">Guides</th></tr>
      </thead>
      <tbody>
        {
          ageBands.map((band) => {
            const linked = band.ages.filter((age) => livePages.has(age));
            return (
              <tr>
                <th scope="row">{band.label}</th>
                <td>{band.chores}</td>
                <td>
                  {linked.length > 0
                    ? linked.map((age, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={agePagePath(age)}>Age {age}</a>
                        </>
                      ))
                    : <a href={PAGES.choresByAge.path}>All ages</a>}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <h2>Chore chart types explained</h2>
  <p>Switch between these in step 3. Your kids and chores carry over, so you can try each one in the preview.</p>
  <h3>Weekly chore chart</h3>
  <p>
    The classic: chores down the side, days across the top and a box to check off each day. It is the best place to
    start for most kids from about age 4, and it is the chart this page opens with.
  </p>
  <h3>Routine chart</h3>
  <p>
    The steps of one part of the day in order, such as getting dressed, brushing teeth and packing a backpack. Routine
    charts work well for kids aged 3 to 7 who need help with busy mornings or bedtime. Start with our
    <a href={PAGES.morningRoutineChart.path}>morning routine chart</a>.
  </p>
  <h3>Reward chart</h3>
  <p>
    A sticker track that leads to a prize you choose, from 5 to 30 stickers. Use it to build one new habit at a time,
    like getting dressed without reminders. Make one with the
    <a href={PAGES.rewardChartMaker.path}>reward chart maker</a>.
  </p>
  <h3>Family chore chart</h3>
  <p>
    Everyone in the house on one color-coded chart, or one page per child, with each chore assigned to one person or
    shared. It is ideal for siblings who like to compare. See the
    <a href={PAGES.familyChoreChart.path}>family chore chart</a>.
  </p>
  <h3>Rotation chart for roommates</h3>
  <p>
    Chores rotate to the next person each week, so nobody gets stuck with the bathroom forever. It suits roommates,
    shared houses and teenagers. Try the <a href={PAGES.roommateChoreChart.path}>roommate chore chart</a>.
  </p>

  <h2>Tips to make a chore chart actually work</h2>
  <ul>
    <li>
      <strong>Be consistent.</strong> Do chores at the same time daily and tie them to existing routines. Check the chart together for the first few weeks.
    </li>
    <li>
      <strong>Use pictures for pre-readers.</strong> Picture icons let younger kids follow the chart themselves.
    </li>
    <li>
      <strong>Teach first, then expect.</strong> Do each chore together first and accept a kid-sized standard.
    </li>
    <li>
      <strong>Rewards and allowance.</strong> Stickers build new habits; an allowance teaches money skills.
    </li>
    <li>
      <strong>Hang it where chores happen.</strong> Put the chart at your child's eye level on the fridge or bedroom door.
    </li>
    <li>
      <strong>Reset weekly.</strong> Review progress together on Sundays, celebrate wins, and swap chores that need adjusting.
    </li>
  </ul>

  <h2>How to handle chore reluctance without nagging</h2>
  <p>
    When kids push back against daily responsibilities, adding more pressure or lecturing usually creates resentment. Instead, tie chores directly to daily privileges using "When/Then" framing: "When your backpack is unpacked and shoes are put away, then you can have screen time or play outside." This removes you as the adversary and lets the household routine serve as the neutral boundary. Keep chores predictable by doing them at the same time every day—such as immediately after school or right before dinner—so completion becomes an automatic habit rather than an ongoing debate.
  </p>
  <p>
    Review your chart every two to three months. As kids grow, tasks that were once challenging become second nature, while new developmental milestones open up opportunities for greater responsibility. Retiring older chores and introducing fresh challenges keeps children engaged and builds real pride in their growing household competence.
  </p>

  <h2>Printing tips</h2>
  <ul>
    <li>
      <strong>Paper size:</strong> Choose Letter or A4 in step 3 and print at actual size (100%). Cardstock holds up best.
    </li>
    <li>
      <strong>Laminate and reuse:</strong> Place in a sheet protector and use dry-erase markers for months of reuse.
    </li>
    <li>
      <strong>Save ink:</strong> Turn on Ink saver for a clean white background with outlines.
    </li>
    <li>
      <strong>No printer:</strong> Save a PNG for your tablet or print the PDF at a local library.
    </li>
  </ul>

  <h2>Privacy: names stay in your browser</h2>
  <p>
    Everything you type, including names, ages and chores, is saved only in your browser on this device. There are no
    accounts, and your chart is never uploaded to our server. Share links keep the chart in the part of the link after
    the # sign, which browsers do not send to any server. We never record what you type. Read the
    <a href={PAGES.privacyPolicy.path}>privacy policy</a> for details.
  </p>
</ToolLayout>
