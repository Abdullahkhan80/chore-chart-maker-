---
import ToolLayout from '../layouts/ToolLayout.astro';
import { PAGES } from '../lib/pages.ts';
import type { FaqItem } from '../lib/seo.ts';

const faq: FaqItem[] = [
  {
    question: 'How does a reward chart work?',
    answer:
      'Your child earns a sticker or a check mark each time they do the chosen task. When the sticker track is full, they get the reward you agreed on together.',
  },
  {
    question: 'How many stickers should a reward chart have?',
    answer:
      'You can set a goal from 5 to 30 stickers. Young children need a short track, around 5 to 10, so the reward comes within a few days. Older kids can work toward a longer goal.',
  },
  {
    question: 'What are good rewards for kids?',
    answer:
      'Experiences often work better than toys: a trip to the park, choosing dinner, an extra bedtime story, baking together or a family movie night. Choose the reward with your child.',
  },
  {
    question: 'Should a reward chart focus on one behavior?',
    answer:
      'Yes, at first. One clear goal, such as getting dressed without reminders, is easier for a child to understand. Once the habit sticks, phase out the chart and start a new one.',
  },
  {
    question: 'Can I make reward charts for several children?',
    answer:
      'Yes. Add each child in step 1 and the reward chart maker prints one page per child, each with their own name and sticker track.',
  },
];
---

<ToolLayout page={PAGES.rewardChartMaker} faq={faq}>
  <Fragment slot="intro">Set a goal, choose a reward and print a sticker chart your child can fill in. Free, no sign-up, and private by design.</Fragment>

  <h2>How to use a reward chart effectively</h2>
  <p>
    Reward charts are one of the most effective tools for positive reinforcement. Unlike a general chore schedule,
    a reward chart targets one or two specific behaviors—such as staying in bed, potty training, completing homework,
    or brushing teeth without a battle.
  </p>
  <ul>
    <li>
      <strong>Keep goals achievable:</strong> Start with a short track of 5 to 10 stickers for younger children so they
      reach the milestone quickly and feel successful.
    </li>
    <li>
      <strong>Agree on the reward together:</strong> Pick motivating rewards like extra playground time, choosing movie
      night, or baking cookies together.
    </li>
    <li>
      <strong>Celebrate consistency:</strong> Place stickers right when the positive behavior happens to build a clear
      connection between effort and recognition.
    </li>
  </ul>

  <h2>Related charts and tools</h2>
  <p>Looking for a different chart format? Explore our free printable tools:</p>
  <ul>
    <li>
      <a href={PAGES.choreChartMaker.path}>Free Chore Chart Maker</a>: Build a full weekly schedule with picture icons
      for everyday household chores.
    </li>
    <li>
      <a href={PAGES.morningRoutineChart.path}>Morning Routine Chart</a>: Visual picture steps to make school morning
      preparations smooth and stress-free.
    </li>
    <li>
      <a href={PAGES.familyChoreChart.path}>Family Chore Chart</a>: Manage household tasks for all family members on
      one shared printable chart.
    </li>
    <li>
      <a href={PAGES.freeChoreChartTemplate.path}>Free Chore Chart Templates</a>: Ready-made printable templates for
      quick editing and instant download.
    </li>
    <li>
      <a href={PAGES.choresByAge.path}>Chores by Age Guide</a>: Age-by-age recommendations from toddlers to teenagers.
    </li>
  </ul>
</ToolLayout>
