---
import ToolLayout from '../layouts/ToolLayout.astro';
import { PAGES } from '../lib/pages.ts';
import type { FaqItem } from '../lib/seo.ts';

const faq: FaqItem[] = [
  {
    question: 'How does a roommate chore chart work?',
    answer:
      'A rotation chart assigns tasks weekly, cycling each chore automatically so turns are shared fairly.',
  },
];
---

<ToolLayout page={PAGES.roommateChoreChart} faq={faq}>
  <Fragment slot="intro">
    A free printable roommate chore chart that rotates weekly so flatmates share tasks fairly.
  </Fragment>

  <h2>Rotating chores for shared homes</h2>
  <p>
    A weekly rotation ensures everyone shares cleaning duties, keeping expectations clear and fair.
  </p>

  <h2>Related chart makers</h2>
  <p>
    Explore our other free tools:
    <a href={PAGES.choreChartMaker.path}>Chore Chart Maker</a>,
    <a href={PAGES.familyChoreChart.path}>Family Chore Chart</a>,
    <a href={PAGES.morningRoutineChart.path}>Morning Routine</a>,
    <a href={PAGES.rewardChartMaker.path}>Reward Chart</a>, and
    <a href={PAGES.freeChoreChartTemplate.path}>Free Templates</a>.
  </p>
</ToolLayout>
