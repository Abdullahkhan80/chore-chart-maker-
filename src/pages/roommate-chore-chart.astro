---
import ToolLayout from '../layouts/ToolLayout.astro';
import { PAGES } from '../lib/pages.ts';
import type { FaqItem } from '../lib/seo.ts';

const faq: FaqItem[] = [
  {
    question: 'How does a roommate chore chart work?',
    answer: 'Chores rotate weekly so everyone takes turns fairly.',
  },
  {
    question: 'How many people can share a chart?',
    answer: 'Up to eight people and twenty chores fit on one chart.',
  },
  {
    question: 'Is the roommate chore chart free?',
    answer: 'Yes. 100% free with no sign-up; data stays private in your browser.',
  },
];
---

<ToolLayout page={PAGES.roommateChoreChart} faq={faq}>
  <Fragment slot="intro">
    Free roommate chore chart maker: rotate chores weekly and print for the fridge. Also see our
    <a href={PAGES.choreChartMaker.path} class="underline">chore chart maker</a>.
  </Fragment>
</ToolLayout>
