---
import ToolLayout from '../layouts/ToolLayout.astro';
import { PAGES } from '../lib/pages.ts';
import type { FaqItem } from '../lib/seo.ts';

const faq: FaqItem[] = [
  {
    question: 'What should be on a morning routine chart for kids?',
    answer:
      'Keep it to the steps your child actually needs before leaving the house: get dressed, eat breakfast, brush teeth, brush hair, pack the backpack and put on shoes. Five or six steps is plenty.',
  },
  {
    question: 'At what age does a morning routine chart help?',
    answer:
      'Routine charts work best from about age 3 to 8. Picture steps let pre-readers follow along, and older kids like checking off each step on their own.',
  },
  {
    question: 'Can my child use the chart without reading?',
    answer:
      'Yes. Every step has a picture icon, so children who cannot read yet can follow the chart from the pictures alone. Turn on large text to make it easier to see.',
  },
  {
    question: 'Where should I hang a morning routine chart?',
    answer:
      'Put it where the routine happens, at your child\'s eye level: on their bedroom door, by the bathroom sink or next to the front door where shoes and backpacks go.',
  },
  {
    question: 'Can I make a bedtime routine chart as well?',
    answer:
      'Yes. Keep the Routine chart type and swap the steps for evening ones like bath, pajamas, brushing teeth and reading a book, then print it as a second chart.',
  },
];
---

<ToolLayout page={PAGES.morningRoutineChart} faq={faq}>
  <Fragment slot="intro">Help kids get out the door with a simple step-by-step morning routine chart they can follow on their own.</Fragment>

  <h2>Creating calmer mornings with visual routines</h2>
  <p>
    School mornings can be chaotic when parents have to repeat instructions over and over. A visual routine chart gives
    children clear ownership of their morning habits, from brushing teeth to putting on shoes.
  </p>
  <ul>
    <li>
      <strong>Pictures for young kids:</strong> Clear icons allow toddlers and pre-kindergarten children to see exactly
      what comes next without needing to read words.
    </li>
    <li>
      <strong>Sequential order:</strong> Arrange steps in the exact order they happen (e.g. get dressed, eat breakfast,
      brush teeth, pack backpack, put on shoes).
    </li>
    <li>
      <strong>Keep it focused:</strong> Stick to 4 to 6 core morning essentials so children feel capable and not
      overwhelmed.
    </li>
  </ul>

  <h2>Related printable tools</h2>
  <p>Discover other printable templates and chore charts for your family:</p>
  <ul>
    <li>
      <a href={PAGES.choreChartMaker.path}>Chore Chart Maker</a>: Make customized weekly chore charts with points and
      allowance tracking.
    </li>
    <li>
      <a href={PAGES.rewardChartMaker.path}>Reward Chart Maker</a>: Encourage positive habits with fun sticker tracks and
      milestone prizes.
    </li>
    <li>
      <a href={PAGES.familyChoreChart.path}>Family Chore Chart</a>: Keep household responsibilities organized across all
      siblings and parents.
    </li>
    <li>
      <a href={PAGES.freeChoreChartTemplate.path}>Free Chore Chart Templates</a>: Ready-made printable layouts to edit
      and print instantly.
    </li>
    <li>
      <a href={PAGES.choresByAge.path}>Chores by Age Guide</a>: Age-appropriate ideas from toddlers to teenagers.
    </li>
  </ul>
</ToolLayout>
