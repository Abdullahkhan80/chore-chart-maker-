---
import InfoLayout from '../layouts/InfoLayout.astro';
import { PAGES } from '../lib/pages.ts';
import { SITE_CONFIG, buildContactPage } from '../lib/seo.ts';

const contactJsonLd = [
  buildContactPage({
    name: PAGES.contact.label,
    description: PAGES.contact.description,
    path: PAGES.contact.path,
    datePublished: PAGES.contact.published,
    dateModified: PAGES.contact.lastmod,
  }),
];

const link = 'font-semibold text-brand underline';
---

<InfoLayout page={PAGES.contact} jsonLd={contactJsonLd}>
  <p class="text-lg">
    Have feedback, questions, or ideas for new printable charts? We would love to hear from you. Email us directly at
    <a href={`mailto:${SITE_CONFIG.email}`} class={link}>{SITE_CONFIG.email}</a>. We read every message and welcome feedback that helps make our tools more useful for families and teachers.
  </p>

  <h2 class="pt-6 text-xl font-bold text-fg">How we can help</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Bug reports & technical help</h3>
      <p class="mt-2 text-sm text-muted">
        If something is not exporting or displaying properly, please let us know your web browser (such as Chrome, Safari, or Firefox), your device type (desktop, tablet, or mobile phone), and whether you were exporting to PDF, PNG, or printing directly. Including the exact steps you took before the issue happened helps us reproduce and fix it quickly.
      </p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Chore & icon suggestions</h3>
      <p class="mt-2 text-sm text-muted">
        Looking for a specific household chore, morning routine step, or illustrated icon that is not in our library yet? Tell us which chore or icon you would like to see. We read every suggestion, though we can't promise to add each one.
      </p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Classroom & community use</h3>
      <p class="mt-2 text-sm text-muted">
        Teachers, occupational therapists, daycares, and homeschoolers are welcome to print, copy, and share charts for classroom and household use at no cost.
      </p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Privacy & security queries</h3>
      <p class="mt-2 text-sm text-muted">
        Questions about our client-side storage architecture or zero-tracking promise? Review our <a href={PAGES.privacyPolicy.path} class={link}>privacy policy</a> or email us with any questions about how your charts remain private in your browser.
      </p>
    </div>
  </div>

  <h2 class="pt-8 text-xl font-bold text-fg">Please protect your family's privacy</h2>
  <p class="mt-2 text-muted">
    You do not need to share your children's real names or identifiable personal details when asking for help. If you attach a screenshot to show a layout issue, please crop or blur personal names first.
  </p>
  <p class="mt-2 text-muted">
    Remember that share links pack your chart settings into the URL hash. If you send us a share link, we will only view it to diagnose your technical issue.
  </p>

  <h2 class="pt-8 text-xl font-bold text-fg">Frequently asked questions before writing</h2>
  <div class="mt-4 space-y-4">
    <div>
      <h3 class="font-semibold text-fg">Can I print charts for multiple students or clients?</h3>
      <p class="text-sm text-muted">
        Yes. Teachers, tutors, and caregivers may print, copy, and share charts for classroom and household use at no cost.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-fg">Why did my saved chart disappear?</h3>
      <p class="text-sm text-muted">
        Charts are saved directly in your browser's private local storage. If you clear your browser history or website cookies, or open the tool in private/incognito mode, the browser clears that storage. To prevent loss, bookmark your share link or save a PDF backup.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-fg">Will you ever charge a subscription or sell user data?</h3>
      <p class="text-sm text-muted">
        The site is free to use with no account required, and your chart data stays in your browser. We have no external investors and collect no personal information to monetize.
      </p>
    </div>
  </div>
</InfoLayout>
