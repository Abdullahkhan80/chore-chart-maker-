---
import InfoLayout from '../layouts/InfoLayout.astro';
import { PAGES } from '../lib/pages.ts';
import { SITE_CONFIG, buildContactPage } from '../lib/seo.ts';

const contactJsonLd = [
  buildContactPage({
    name: PAGES.contact.label,
    description: PAGES.contact.description,
    path: PAGES.contact.path,
    datePublished: PAGES.contact.published,
    dateModified: PAGES.contact.lastmod,
  }),
];

const link = 'font-semibold text-brand underline';
---

<InfoLayout page={PAGES.contact} jsonLd={contactJsonLd}>
  <p class="text-lg">
    Have feedback, questions, or ideas for new printable charts? We'd love to hear from you. Email us directly at
    <a href={`mailto:${SITE_CONFIG.email}`} class={link}>{SITE_CONFIG.email}</a>. We read every note and typically reply within 24 to 48 business hours.
  </p>

  <h2 class="pt-6 text-xl font-bold text-fg">How we can help</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Bug reports & technical help</h3>
      <p class="mt-2 text-sm text-muted">
        If something isn't exporting or displaying properly, please let us know your web browser (Chrome, Safari, Firefox), device type (desktop, tablet, mobile), and whether you were exporting to PDF or PNG.
      </p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Chore & icon suggestions</h3>
      <p class="mt-2 text-sm text-muted">
        Looking for a specific household chore, bedtime task, or illustration that isn't in our library yet? We regularly add new icons based on parent and teacher requests.
      </p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Classroom & community use</h3>
      <p class="mt-2 text-sm text-muted">
        Teachers, occupational therapists, daycares, and homeschoolers are welcome to print and distribute as many charts as needed. All tools are completely free for non-commercial educational use.
      </p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-5">
      <h3 class="font-bold text-fg">Privacy & security queries</h3>
      <p class="mt-2 text-sm text-muted">
        Questions about our client-side storage architecture or zero-tracking promise? Review our <a href={PAGES.privacyPolicy.path} class={link}>privacy policy</a> or email us with any questions.
      </p>
    </div>
  </div>

  <h2 class="pt-8 text-xl font-bold text-fg">Please protect your family's privacy</h2>
  <p class="mt-2 text-muted">
    You do not need to share your children's real names or identifiable personal details when asking for help. If you attach a screenshot to show a layout issue, please crop or blur personal names first.
  </p>
  <p class="mt-2 text-muted">
    Remember that share links pack your chart settings into the URL hash. If you send us a share link, we will only view it to diagnose your technical issue.
  </p>

  <h2 class="pt-8 text-xl font-bold text-fg">Frequently asked questions before writing</h2>
  <div class="mt-4 space-y-4">
    <div>
      <h3 class="font-semibold text-fg">Can I print charts for multiple students or clients?</h3>
      <p class="text-sm text-muted">
        Yes! Teachers, tutors, and caregivers are encouraged to print and share our charts freely. There are no limits and no copyright fees for physical classroom handouts.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-fg">Why did my saved chart disappear?</h3>
      <p class="text-sm text-muted">
        Charts are saved directly in your browser's private local storage. If you clear your browser history or website cookies, or open the tool in private/incognito mode, the browser clears that storage. To prevent loss, bookmark your share link or save a PDF backup.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-fg">Will you ever charge a subscription or sell user data?</h3>
      <p class="text-sm text-muted">
        No. {SITE_CONFIG.name} is built as a permanent free public tool. We have no external investors and collect no personal information to monetize.
      </p>
    </div>
  </div>
</InfoLayout>
