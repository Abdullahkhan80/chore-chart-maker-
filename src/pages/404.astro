---
import MainLayout from '../layouts/MainLayout.astro';
import { PAGES } from '../lib/pages.ts';

const page = PAGES.notFound;
---

<MainLayout page={page}>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{page.h1}</h1>
  <p class="mt-4 text-lg text-muted">Sorry, we couldn't find that page. It may have moved, or the link may be mistyped.</p>
  <p class="mt-6">
    <a href="/" class="text-brand underline">Go to the home page</a> or
    <a href={PAGES.choreChartMaker.path} class="text-brand underline">make a chore chart</a>.
  </p>
</MainLayout>
