const age = Number(Astro.params.age);
const page = agePage(age);
const content = AGE_CONTENT[age];
const prevAge = age > 2 ? age - 1 : null;
const nextAge = age < 14 ? age + 1 : null;

const article = buildArticle({
  headline: page.h1,
  description: page.description,
  path: page.path,
  datePublished: page.published,
  dateModified: page.lastmod,
  imagePath: pageOgImagePath(page),
  lang: page.lang,
});

const faqItems: FaqItem[] = content.faqs.map((f) => ({
  question: f.q,
  answer: f.a,
}));

function aOrAn(n: number): string {
  if (n === 8 || n === 11 || n === 18 || (n >= 80 && n <= 89)) return 'an';
  return 'a';
}

const hasFaqPage = content.faqs && content.faqs.length === 5;
const customJsonLd = hasFaqPage ? [article, buildFaqPage(faqItems, page.path)] : undefined;
---

<ArticleLayout
  page={page}
  preset={`age-${age}`}
  breadcrumbs={[
    { name: PAGES.choresByAge.label, path: PAGES.choresByAge.path },
    { name: page.label, path: page.path },
  ]}
  jsonLd={customJsonLd}
  ogType="article"
>
  <p class="text-lg leading-relaxed">{content.intro}</p>
