const age = Number(Astro.params.age);
const page = agePage(age);
const content = AGE_CONTENT[age];
const prevAge = age > 2 ? age - 1 : null;
const nextAge = age < 14 ? age + 1 : null;
---

<ArticleLayout
  page={page}
  preset={`age-${age}`}
  breadcrumbs={[
    { name: PAGES.choresByAge.label, path: PAGES.choresByAge.path },
    { name: page.label, path: page.path },
  ]}
>
  <p class="text-lg leading-relaxed">{content.intro}</p>
  <p>
    <a href={PAGES.choreChartMaker.path} class="font-semibold text-brand underline">Customize and print</a>
    {' '}a free chore chart for this age.
  </p>

  <h2>What most {age}-year-olds can do</h2>
  <p>{content.whatTheyCanDo}</p>

  <h2>Age-appropriate chores for {age}-year-olds</h2>
  <p>Tasks {age}-year-olds can manage with practice. Start with two or three and build from there.</p>
  <ul class="space-y-2">
    {content.chores.map((chore) => (
      <li>
        <strong>{chore.name}:</strong> {chore.desc}
      </li>
    ))}
  </ul>

  <h2>Sample weekly routine for a {age}-year-old</h2>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-line bg-surface p-4">
      <h3 class="font-bold text-fg">Morning routine</h3>
      <p class="mt-1 text-sm text-muted">{content.schedule.morning}</p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-4">
      <h3 class="font-bold text-fg">Afternoon / Evening</h3>
      <p class="mt-1 text-sm text-muted">{content.schedule.afternoon}</p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-4">
      <h3 class="font-bold text-fg">Weekend tasks</h3>
      <p class="mt-1 text-sm text-muted">{content.schedule.weekend}</p>
    </div>
  </div>

  <h2>How to teach chores to a {age}-year-old</h2>
  <ol class="space-y-2">
    <li><strong>Step 1:</strong> {content.howToTeach.step1}</li>
    <li><strong>Step 2:</strong> {content.howToTeach.step2}</li>
    <li><strong>Step 3:</strong> {content.howToTeach.step3}</li>
  </ol>

  <h2>Safety and supervision guidance</h2>
  <div class="rounded-xl border border-line bg-surface p-4 text-sm text-muted">
    <p>{content.safetyNote}</p>
    <p class="mt-2 text-xs italic">
      Note on developmental references: Official CDC developmental milestone checklists focus on early childhood development from birth through age 5. For ages 6 and older, chore capabilities reflect guidance from the American Academy of Pediatrics (AAP) and child development standards.
    </p>
  </div>

  <h2>Teaching tips for {age}-year-olds</h2>
  <ul class="space-y-1">
    {content.tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>

  <h2>Not quite yet: tasks to avoid at {age}</h2>
  <p>{content.notYet}</p>

  <h2>Frequently asked questions about chores for {age}-year-olds</h2>
  <div class="space-y-4">
    {content.faqs.map((faq) => (
      <div class="rounded-xl border border-line bg-surface p-4">
        <h3 class="font-bold text-fg">{faq.q}</h3>
        <p class="mt-1 text-sm text-muted">{faq.a}</p>
      </div>
    ))}
  </div>

  <nav class="my-6 border-y border-line py-4" aria-label="Age navigation">
    <div class="flex flex-wrap items-center justify-between gap-4">
      {prevAge ? (
        <a href={agePage(prevAge).path} class="text-sm font-medium text-brand underline">
          ← Chores for {prevAge}-year-olds
        </a>
      ) : (
        <span />
      )}
      <a href={PAGES.choresByAge.path} class="text-sm font-medium text-muted hover:text-fg">
        All Ages Guide (2–14)
      </a>
      {nextAge ? (
        <a href={agePage(nextAge).path} class="text-sm font-medium text-brand underline">
          Chores for {nextAge}-year-olds →
        </a>
      ) : (
        <span />
      )}
    </div>
    <div class="mt-4">
      <p class="text-xs font-semibold text-muted">Other ages:</p>
      <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
        {AGE_PAGE_AGES.map((a) =>
          a === age ? (
            <span class="rounded bg-brand px-1.5 py-0.5 font-bold text-brand-fg">Age {a}</span>
          ) : (
            <a href={agePage(a).path} class="rounded border border-line px-1.5 py-0.5 hover:border-brand">
              Age {a}
            </a>
          ),
        )}
      </div>
    </div>
  </nav>

  <section class="mt-8 border-t border-line pt-4 text-sm text-muted">
    <p>
      Related tools:
      <a href={PAGES.choreChartMaker.path} class="text-brand underline font-medium">Chore Chart Maker</a> ·
      <a href={PAGES.rewardChartMaker.path} class="text-brand underline font-medium">Reward Chart</a> ·
      <a href={PAGES.morningRoutineChart.path} class="text-brand underline font-medium">Morning Routine</a> ·
      <a href={PAGES.bedtimeRoutineChart.path} class="text-brand underline font-medium">Bedtime Routine</a> ·
      <a href={PAGES.familyChoreChart.path} class="text-brand underline font-medium">Family Chart</a>.
    </p>
  </section>
</ArticleLayout>
