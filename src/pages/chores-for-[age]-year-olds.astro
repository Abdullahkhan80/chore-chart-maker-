---
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { PAGES, AGE_PAGE_AGES, agePage } from '../lib/pages.ts';

export const getStaticPaths = (() =>
  AGE_PAGE_AGES.map((age) => ({ params: { age: String(age) } }))) satisfies GetStaticPaths;

interface AgeChore {
  name: string;
  desc: string;
}

interface AgeData {
  intro: string;
  whatTheyCanDo: string;
  chores: AgeChore[];
  tips: string[];
  notYet: string;
}

const AGE_CONTENT: Record<number, AgeData> = {
  3: {
    intro:
      "Three-year-olds have boundless enthusiasm to copy everything you do. Chores at this age build the habit of helping as part of everyday routines.",
    whatTheyCanDo:
      'A 3-year-old can follow a simple instruction, sustain effort for 5 minutes, and handle gross-motor tasks like carrying light items or placing toys in bins.',
    chores: [
      { name: 'Put toys in a bin', desc: 'A large, open bin without a lid makes tidying simple and fast.' },
      { name: 'Put dirty clothes in the hamper', desc: 'One clear step with an immediate visible result.' },
      { name: 'Wipe up small spills', desc: 'Hand them a small cloth to wipe table or counter spills.' },
      { name: 'Carry light groceries', desc: 'Carrying a loaf of bread or box of crackers makes them part of the team.' },
      { name: 'Sort laundry by color', desc: 'Help sort clothes into dark and light piles as a matching game.' },
      { name: 'Put shoes in the shoe rack', desc: 'Returning shoes to one designated spot every time they come inside.' },
    ],
    tips: [
      "Do chores alongside them every time. Model the actions with warm encouragement.",
      'Keep every task under 5 minutes to match their natural attention span.',
      "Praise specifically: 'Thank you for putting all the blocks in the bin!'",
    ],
    notYet:
      'Multi-step tasks without supervision, carrying heavy items, handling glass, or working near hot water.',
  },

  4: {
    intro:
      "Four-year-olds are eager helpers who understand cause and effect. They remember regular spots for belongings and take pride in completing tasks.",
    whatTheyCanDo:
      'A 4-year-old can follow two-step directions, work for 10 minutes, and handle basic matching and sorting tasks with growing coordination.',
    chores: [
      { name: 'Make their bed', desc: 'Pull up the duvet and straighten pillows each morning.' },
      { name: 'Set napkins and silverware', desc: 'Place forks, spoons, and napkins at each seat with guidance.' },
      { name: 'Match clean socks', desc: 'Turn matching clean socks from the laundry basket into a fun puzzle.' },
      { name: 'Feed the family pet', desc: 'Scoop dry kibble into a bowl with supervision.' },
      { name: 'Wipe the dining table', desc: 'Use a damp sponge to wipe down placemats and table surfaces after meals.' },
      { name: 'Put books on the shelf', desc: 'Return storybooks to their designated shelf or basket.' },
    ],
    tips: [
      'Show what the completed task looks like so they have a clear visual goal.',
      'Use a show-tell-do approach: demonstrate first, explain aloud, then let them try.',
      'Avoid redoing their work in front of them—encourage effort over perfection.',
    ],
    notYet:
      'Sharp kitchen tools, carrying heavy laundry baskets, or multi-step tasks without visual guidance.',
  },

  5: {
    intro:
      "Five-year-olds entering school thrive on daily routines. They manage multi-step personal responsibilities and take pride in completed work.",
    whatTheyCanDo:
      'A 5-year-old can follow three-step instructions, focus for 15 minutes, recognize words, and perform precise sorting and tidying independently.',
    chores: [
      { name: 'Make bed neatly', desc: 'Straighten sheets, pull up the comforter, and arrange pillows each morning.' },
      { name: 'Rinse their own plate', desc: 'Scrape food scraps into the compost and rinse dishes at the sink.' },
      { name: 'Water houseplants', desc: 'Use a small watering can to water designated potted plants weekly.' },
      { name: 'Fold towels and washcloths', desc: 'Fold simple flat items and stack them in linen baskets.' },
      { name: 'Sort recyclable materials', desc: 'Sort clean paper, plastic, and cardboard into recycling bins.' },
      { name: 'Wipe bathroom counter and sink', desc: 'Wipe down the faucet and counter with a damp cloth after brushing teeth.' },
    ],
    tips: [
      'Let them choose the order of their chores to give them a sense of ownership.',
      'Anchor chores to existing habits, like clearing dishes immediately after breakfast.',
      'Use a colorful sticker chart to track consistency across the week.',
    ],
    notYet:
      'Operating the stove or microwave alone, cleaning toilets, or using chemical household cleaners.',
  },

  6: {
    intro:
      "Six-year-olds have a growing sense of responsibility and fairness. They thrive when chores are framed as teamwork where everyone contributes.",
    whatTheyCanDo:
      'A 6-year-old can read their chore chart, sustain effort for 20 minutes, and complete physical routines with good coordination and minimal supervision.',
    chores: [
      { name: 'Sweep kitchen floors', desc: 'Sweep along baseboards and gather debris into a dustpan.' },
      { name: 'Help prepare simple snacks', desc: 'Wash vegetables, tear lettuce, spread butter, or measure dry ingredients.' },
      { name: 'Walk family pets with an adult', desc: 'Hold the lead alongside an adult and practice responsible pet care.' },
      { name: 'Put away folded clothes', desc: 'Sort their own clean clothes into the correct bedroom drawers.' },
      { name: 'Pack their school backpack', desc: 'Check books, folders, and water bottle against a night-before checklist.' },
      { name: 'Empty small wastebaskets', desc: 'Empty bedroom and bathroom bins into the central kitchen trash.' },
    ],
    tips: [
      "Explain the purpose behind tasks: 'We pack tonight so morning departures are calm.'",
      'Allow them to problem-solve when they forget a step before stepping in.',
      'Offer do-overs with gentle guidance instead of criticism when work falls short.',
    ],
    notYet:
      'Stovetop cooking, handling harsh cleaning chemicals, or carrying heavy laundry baskets down stairs.',
  },

  7: {
    intro:
      "Seven-year-olds manage multi-step projects independently. Giving them clear ownership of a specific area builds strong intrinsic motivation.",
    whatTheyCanDo:
      'A 7-year-old can follow detailed routines for 25–30 minutes, organize spaces logically, and take pride in executing jobs reliably from start to finish.',
    chores: [
      { name: 'Load and unload dishwasher', desc: 'Load plates, cups, and utensils properly and unload clean items.' },
      { name: 'Clean bathroom sink and mirror', desc: 'Wipe the basin with non-toxic spray and buff the mirror streak-free.' },
      { name: 'Vacuum bedrooms weekly', desc: 'Move lightweight items and vacuum room edges and carpets thoroughly.' },
      { name: 'Rake leaves or sweep patio', desc: 'Help maintain outdoor living areas with appropriately sized tools.' },
      { name: 'Prepare cold lunches independently', desc: 'Make sandwiches, pack fruit, and prep snacks for school days.' },
      { name: 'Fold and organize laundry', desc: 'Fold shirts, pants, and underwear and put them away in closets.' },
    ],
    tips: [
      "Assign ownership of a domain ('dishwasher lead') rather than one-off commands.",
      'Use a 15-minute timer challenge if motivation lags for routine tasks.',
      'Let them manage their own chart check-offs to reinforce self-direction.',
    ],
    notYet:
      'Running laundry machines unsupervised, using sharp chef knives, or mowing the lawn.',
  },

  8: {
    intro:
      "Eight-year-olds have mature executive functioning and can plan, sequence, and self-check their work. Handing over ownership creates lasting confidence.",
    whatTheyCanDo:
      'An 8-year-old can manage multi-step chores for 30–45 minutes, notice when things need cleaning without prompts, and complete detailed household jobs.',
    chores: [
      { name: 'Run the dishwasher cycle', desc: 'Add detergent, choose the right wash cycle, start the wash, and unload.' },
      { name: 'Clean toilets and countertops', desc: 'Use bathroom cleaner, scrub the bowl, and wipe down countertops cleanly.' },
      { name: 'Mop hard-surface floors', desc: 'Sweep and mop kitchen and bathroom floors with warm water and cleaner.' },
      { name: 'Do personal laundry with guidance', desc: 'Sort clothes, load the washer, transfer to the dryer, and fold.' },
      { name: 'Cook simple meals', desc: 'Make scrambled eggs, toast, oatmeal, or warm soup with adult oversight.' },
      { name: 'Take trash bins to the curb', desc: 'Roll waste and recycling bins to the curb on collection days.' },
    ],
    tips: [
      'Define clear quality standards so they know exactly what a finished job looks like.',
      'Offer flexibility on when chores are done as long as deadlines are respected.',
      'Frame these responsibilities as essential life skills that prepare them for independence.',
    ],
    notYet:
      'Power lawn tools, unsupervised ladder use, or handling boiling oil on the stove.',
  },

  9: {
    intro:
      "Nine-year-olds achieve near-adult standards on everyday household tasks. The focus shifts from merely following instructions to taking pride in quality.",
    whatTheyCanDo:
      'A 9-year-old can plan several days ahead, coordinate chores around extracurricular activities, and complete complex household cleaning independently.',
    chores: [
      { name: 'Deep clean a bathroom', desc: 'Scrub the sink, toilet, tub, and floor thoroughly to an adult standard.' },
      { name: 'Vacuum entire floors', desc: 'Vacuum living areas and hallways in an organized, methodical sequence.' },
      { name: 'Run complete laundry cycles', desc: 'Manage washing, drying, folding, and putting away personal laundry.' },
      { name: 'Cook from written recipes', desc: 'Follow simple recipe instructions for pasta dishes, quesadillas, or salads.' },
      { name: 'Assist with younger sibling care', desc: 'Supervise younger siblings during play or assist with simple homework.' },
      { name: 'Yard and garden upkeep', desc: 'Water plants, sweep sidewalks, clear dead leaves, and tidy outdoor toys.' },
    ],
    tips: [
      'Include them when creating the family chore schedule to ensure buy-in.',
      'Inspect the final result rather than hovering over the process as they work.',
      'Give genuine, adult-level praise when they take initiative without being asked.',
    ],
    notYet:
      'Staying home alone for extended periods, operating gas mowers, or handling household finances.',
  },

  10: {
    intro:
      "Ten-year-olds handle household management tasks with genuine autonomy. Chores become true contributions that keep the home functioning smoothly.",
    whatTheyCanDo:
      'A 10-year-old can organize their daily schedule, balance chores with schoolwork, and execute complex multi-step responsibilities with consistent quality.',
    chores: [
      { name: 'Cook family dinners from recipes', desc: 'Plan and prepare full balanced dinners like pasta, skillet meals, or tacos.' },
      { name: 'Deep clean kitchen surfaces', desc: 'Clean stovetop, wipe down appliance fronts, sanitize counters, and mop.' },
      { name: 'Manage personal laundry entirely', desc: 'Wash, dry, fold, and store clothes each week without parental reminders.' },
      { name: 'Mow lawns with supervision', desc: 'Mow flat yard sections after complete safety equipment and tool review.' },
      { name: 'Detail car interiors', desc: 'Vacuum car seats and floor mats, clean windows, and remove trash.' },
      { name: 'Shop with a grocery list and budget', desc: 'Find pantry items, compare prices, and manage payments and receipts.' },
    ],
    tips: [
      'Treat them as a capable partner in maintaining a comfortable, organized home.',
      "Assign ongoing areas of responsibility ('you own the kitchen floor') for accountability.",
      'Discuss how practical household competence builds self-reliance for adulthood.',
    ],
    notYet:
      'Unsupervised power machinery, sole extended care of infants, or managing household budgets.',
  },

  11: {
    intro:
      "Eleven-year-olds are preparing for adolescence, where household chores transition into foundational life skills for future personal independence.",
    whatTheyCanDo:
      'An 11-year-old can anticipate chores before being prompted, manage multi-day tasks, and hold themselves to high personal standards of craftsmanship.',
    chores: [
      { name: 'Plan and cook weekly meals', desc: 'Select recipes, write ingredient lists, cook, and clean up the kitchen.' },
      { name: 'Lead grocery shopping trips', desc: 'Audit pantry supplies, compile shopping lists, and compare unit prices.' },
      { name: 'Tackle seasonal cleaning projects', desc: 'Clean garage shelves, organize basement storage, or clean patio furniture.' },
      { name: 'Mentor younger siblings on chores', desc: 'Demonstrate standards and guide younger siblings through chore routines.' },
      { name: 'Manage personal schedules and chores', desc: 'Coordinate school deadlines, sports practices, and household duties.' },
      { name: 'Perform basic home maintenance', desc: 'Replace light bulbs, tighten loose hinges, or change air filters.' },
    ],
    tips: [
      'Negotiate chore swaps when busy schedules require flexible arrangements.',
      'Respect their independence by agreeing on deadlines rather than exact times.',
      'Treat mistakes as learning opportunities and praise self-directed problem-solving.',
    ],
    notYet:
      'Operating dangerous power tools, unsupervised sole care of infants, or financial autonomy.',
  },

  12: {
    intro:
      "Twelve-year-olds have near-adult capability for standard home tasks. Giving them serious responsibilities prepares them for high school and independent living.",
    whatTheyCanDo:
      'A 12-year-old can plan, execute, and inspect complex tasks to adult standards, manage weekly deadlines independently, and lead family routines.',
    chores: [
      { name: 'Cook diverse family dinners', desc: 'Prepare full multi-dish meals reliably on scheduled cooking nights.' },
      { name: 'Run full household laundry days', desc: 'Wash, dry, fold, and sort family linens, towels, and clothing batches.' },
      { name: 'Deep clean any room in the house', desc: 'Clean baseboards, windows, surfaces, and flooring to a spotless standard.' },
      { name: 'Maintain lawns and garden areas', desc: 'Mow lawns, edge walkways, weed garden beds, and water outdoor plants.' },
      { name: 'Supervise siblings during routine chores', desc: 'Provide constructive feedback and support while siblings complete tasks.' },
      { name: 'Handle local neighbourhood errands', desc: 'Walk to local shops with shopping lists or drop mail at the post office.' },
    ],
    tips: [
      'Frame responsibilities explicitly as essential preparation for independent adult living.',
      'Provide authentic ownership where their contribution has visible, appreciated value.',
      'Acknowledge mature contributions with adult-level appreciation and privileges.',
    ],
    notYet:
      'Unsupervised heavy power tools, sole legal responsibility for young kids, or independent finances.',
  },
};

const age = Number(Astro.params.age);
const page = agePage(age);
const content = AGE_CONTENT[age];
const prevAge = age > 3 ? age - 1 : null;
const nextAge = age < 12 ? age + 1 : null;
---

<ArticleLayout
  page={page}
  preset={`age-${age}`}
  breadcrumbs={[
    { name: PAGES.choresByAge.label, path: PAGES.choresByAge.path },
    { name: page.label, path: page.path },
  ]}
>
  <p>{content.intro}</p>
  <p>
    <a href={PAGES.choreChartMaker.path} class="font-semibold text-brand underline">Open the chore chart maker</a>
    {' '}to customize and print a chart for this age.
  </p>

  <h2>What most {age}-year-olds can do</h2>
  <p>{content.whatTheyCanDo}</p>

  <h2>Age-appropriate chores for {age}-year-olds</h2>
  <p>Tasks {age}-year-olds can manage with practice. Start with two or three and build from there.</p>
  <ul>
    {content.chores.map((chore) => (
      <li>
        <strong>{chore.name}:</strong> {chore.desc}
      </li>
    ))}
  </ul>

  <h2>Teaching tips for {age}-year-olds</h2>
  <ul>
    {content.tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>

  <h2>Not quite yet</h2>
  <p>{content.notYet}</p>

  <nav class="my-6 border-y border-line py-4" aria-label="Age navigation">
    <div class="flex flex-wrap items-center justify-between gap-4">
      {prevAge ? (
        <a href={agePage(prevAge).path} class="text-sm font-medium text-brand underline">
          ← Chores for {prevAge}-year-olds
        </a>
      ) : (
        <span />
      )}
      <a href={PAGES.choresByAge.path} class="text-sm font-medium text-muted hover:text-fg">
        All Ages Guide (2–14)
      </a>
      {nextAge ? (
        <a href={agePage(nextAge).path} class="text-sm font-medium text-brand underline">
          Chores for {nextAge}-year-olds →
        </a>
      ) : (
        <span />
      )}
    </div>
    <div class="mt-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">Browse chores by other ages:</p>
      <div class="mt-2 flex flex-wrap gap-2 text-sm">
        {AGE_PAGE_AGES.map((a) =>
          a === age ? (
            <span class="rounded bg-brand px-2 py-0.5 text-xs font-bold text-brand-fg">{a} years</span>
          ) : (
            <a
              href={agePage(a).path}
              class="rounded border border-line px-2 py-0.5 text-xs font-medium hover:border-brand"
            >
              {a} years
            </a>
          ),
        )}
      </div>
    </div>
  </nav>

  <section class="mt-8 space-y-2 border-t border-line pt-6">
    <h2 class="text-lg font-bold text-fg">Related printable chart tools</h2>
    <p class="text-sm text-muted">
      Explore our free tools:
      <a href={PAGES.choreChartMaker.path} class="text-brand underline font-medium">Chore Chart Maker</a>,
      <a href={PAGES.rewardChartMaker.path} class="text-brand underline font-medium">Reward Chart</a>,
      <a href={PAGES.morningRoutineChart.path} class="text-brand underline font-medium">Morning Routine</a>,
      <a href={PAGES.familyChoreChart.path} class="text-brand underline font-medium">Family Chart</a>,
      <a href={PAGES.freeChoreChartTemplate.path} class="text-brand underline font-medium">Templates</a>, and
      <a href={PAGES.elegantChoreChart.path} class="text-brand underline font-medium">Elegant Charts</a>.
    </p>
  </section>
</ArticleLayout>
