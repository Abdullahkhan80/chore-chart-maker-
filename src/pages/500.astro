---
// Static page that src/worker.ts serves with a 500 status when serving the site fails.
// The site is fully static, so Astro's on-demand 500 handling never applies here.
import MainLayout from '../layouts/MainLayout.astro';
import { PAGES } from '../lib/pages.ts';

const page = PAGES.serverError;
---

<MainLayout page={page}>
  <div class="max-w-prose">
    <p class="text-sm font-semibold tracking-wide text-muted uppercase">Error 500</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{page.h1}</h1>
    <p class="mt-4 text-lg text-muted">
      Sorry, something went wrong on our end. Please refresh the page or try again in a moment.
    </p>
    <p class="mt-4">
      Your chart is saved in your browser, not on our servers, so nothing you made has been lost.
    </p>
    <p class="mt-6">
      <a href="/" class="text-brand underline">Go to the home page</a> or
      <a href={PAGES.choreChartMaker.path} class="text-brand underline">open the chore chart maker</a>.
    </p>
    <p class="mt-8 text-sm text-muted">
      Still seeing this? <a href={PAGES.contact.path} class="text-brand underline">Let us know</a>.
    </p>
  </div>
</MainLayout>
